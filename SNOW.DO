1000 REM DRIVEWAY SHOVELER (SNOW.DO) - MODEL 100 BASIC
1020 REM CONTROLS: W/A/S/D OR ARROWS. R=RESTART, Q=QUIT.
1040 DIM S%(9,41),O%(9,41),PT%(41)
1060 P0!=0:P2!=0:SM%=0:RD%=0:NZ%=0
1090 VER$="v0.1.0"
1092 SW%=40:SH%=8
1080 REM INPUT + MOVE LOOP
1100 REM DISABLE SCROLLING
1120 PRINT CHR$(27);"V";
1140 GOSUB 6000
1160 GOSUB 7000
1180 GOSUB 9600:GOSUB 10000
1200 GOSUB 3000
1220 GOSUB 4000
1240 IF WN% THEN 5000
1260 NZ%=NZ%+1:IF NZ%>30000 THEN NZ%=0
1270 K$=INKEY$:IF K$="" THEN 1260
1280 IF K$="Q" OR K$="q" THEN GOSUB 7000:GOSUB 9600:GOSUB 10000:GOSUB 3000:GOSUB 4000:GOTO 1240
1300 IF K$="R" OR K$="r" THEN GOSUB 9600:GOSUB 10000:GOSUB 3000:GOSUB 4000:GOTO 1240
1320 RS%=0:CS%=0
1340 IF K$="A" OR K$="a" OR K$=CHR$(29) THEN RS%=0:CS%=-1:GOTO 1440
1360 IF K$="D" OR K$="d" OR K$=CHR$(28) THEN RS%=0:CS%=1:GOTO 1440
1380 IF K$="W" OR K$="w" OR K$=CHR$(30) THEN RS%=-1:CS%=0:GOTO 1440
1400 IF K$="S" OR K$="s" OR K$=CHR$(31) THEN RS%=1:CS%=0:GOTO 1440
1420 GOTO 1240
1440 NR%=PR%+RS%:NC%=PC%+CS%
1460 IF NR%<1 OR NR%>8 OR NC%<1 OR NC%>40 THEN 1240
1480 IF NR%<2 OR NR%>7 OR O%(NR%,NC%)<>0 OR S%(NR%,NC%)<>0 THEN 1600
1500 PA%=PR%:PB%=PC%:PR%=NR%:PC%=NC%
1520 RR%=PA%:CC%=PB%:GOSUB 4300
1540 RR%=PR%:CC%=PC%:GOSUB 4300
1560 IF PC%=40 THEN WN%=1:GOTO 5000
1580 GOTO 1240
1600 IF O%(NR%,NC%)<>0 THEN 1240
1620 IF S%(NR%,NC%)<=0 THEN 1240
1640 TR%=NR%+RS%:TC%=NC%+CS%
1660 IF TR%<1 OR TR%>8 OR TC%<1 OR TC%>40 THEN 1240
1680 IF O%(TR%,TC%)<>0 THEN 1240
1700 CP%=3:IF TR%=1 OR TR%=8 THEN CP%=5
1720 SP%=CP%-S%(TR%,TC%):IF SP%<=0 THEN 1240
1740 MV%=S%(NR%,NC%):IF MV%>SP% THEN MV%=SP%
1760 S%(NR%,NC%)=S%(NR%,NC%)-MV%
1780 S%(TR%,TC%)=S%(TR%,TC%)+MV%
1800 RR%=NR%:CC%=NC%:GOSUB 4300
1820 RR%=TR%:CC%=TC%:GOSUB 4300
1840 IF WN% THEN 5000
1860 GOTO 1240

2000 REM SET SNOW PARAMS FROM MODE
2020 IF SM%=0 THEN P0!=0:P2!=0:RD%=0:RETURN
2040 IF SM%=1 THEN P0!=0.25:P2!=0.05:RD%=1:RETURN
2060 IF SM%=2 THEN P0!=0.15:P2!=0.1:RD%=1:RETURN
2080 IF SM%=3 THEN P0!=0.05:P2!=0.25:RD%=1:RETURN
2100 RETURN

3000 REM INIT BOARD
3020 WN%=0:PR%=4:PC%=1
3040 FOR R%=1 TO 8
3060 FOR C%=1 TO 40
3080 IF R%=1 OR R%=8 THEN S%(R%,C%)=0:GOTO 3120
3100 IF C%=1 OR C%=40 THEN S%(R%,C%)=0 ELSE S%(R%,C%)=1
3120 NEXT C%
3140 NEXT R%
3160 GOSUB 2000
3180 IF RD%=0 THEN 3320
3200 FOR TR%=1 TO 5
3240 GOSUB 8140
3260 GOSUB 8460
3280 IF OK%=1 THEN GOTO 3320
3300 NEXT TR%
3320 FOR R%=1 TO 8
3340 FOR C%=1 TO 40
3360 IF O%(R%,C%)<>0 THEN S%(R%,C%)=0
3380 NEXT C%
3400 NEXT R%
3420 RETURN

4000 REM DRAW BOARD USING PRINT@
4020 CLS
4040 FOR R%=1 TO 8
4060 B$="":RM%=0
4080 FOR C%=1 TO 40
4100 RR%=R%:CC%=C%:GOSUB 4500
4120 IF RV%<>RM% THEN IF RV%=1 THEN B$=B$+CHR$(27)+"p" ELSE B$=B$+CHR$(27)+"q"
4140 RM%=RV%:B$=B$+CH$
4160 NEXT C%
4180 IF RM%=1 THEN B$=B$+CHR$(27)+"q"
4200 PO%=(R%-1)*40:PRINT@PO%,B$;
4220 NEXT R%
4240 RETURN

4300 REM DRAW SINGLE CELL AT RR,CC USING PRINT@
4320 PO%=(RR%-1)*40+(CC%-1)
4340 GOSUB 4500
4360 IF RV%=1 THEN PRINT@PO%,CHR$(27);"p";CH$;CHR$(27);"q";:RETURN
4380 PRINT@PO%,CH$;
4400 RETURN

4500 REM COMPUTE CELL CH$ AND RV% FOR RR,CC
4520 IF RR%=PR% AND CC%=PC% THEN CH$=CHR$(147):RV%=0:RETURN
4540 IF O%(RR%,CC%)<>0 THEN CH$="#":RV%=1:RETURN
4560 IF RR%=1 OR RR%=8 THEN IF S%(RR%,CC%)=0 THEN CH$="w":RV%=0:RETURN ELSE CH$=CHR$(48+S%(RR%,CC%)):RV%=1:RETURN
4580 IF S%(RR%,CC%)=0 THEN CH$=" ":RV%=0:RETURN
4600 IF S%(RR%,CC%)=1 THEN CH$=" ":RV%=1:RETURN
4620 CH$=CHR$(48+S%(RR%,CC%)):RV%=1:RETURN

5000 REM WIN HANDLER
5020 PRINT
5040 PRINT "WIN! PATH CLEARED. R=RESTART, Q=QUIT"
5060 K$=INKEY$:IF K$="" THEN 5060
5080 IF K$="R" OR K$="r" THEN GOSUB 9600:GOSUB 10000:GOSUB 3000:GOSUB 4000:GOTO 1240
5100 IF K$="Q" OR K$="q" THEN GOSUB 7000:GOSUB 9600:GOSUB 10000:GOSUB 3000:GOSUB 4000:GOTO 1240
5120 GOTO 5060

5600 REM DRAWBOX BR%,BC%,BH%,BW%
5620 T%=BR%:L%=BC%:H%=BH%:W%=BW%
5640 IF H%<2 OR W%<2 THEN RETURN
5660 PO%=(T%-1)*40+(L%-1):PRINT@PO%,"+";
5680 FOR I%=1 TO W%-2:PRINT@PO%+I%,"-";:NEXT I%
5700 PRINT@PO%+W%-1,"+";
5720 FOR R%=T%+1 TO T%+H%-2
5740 PO%=(R%-1)*40+(L%-1):PRINT@PO%,"|";
5760 PRINT@PO%+W%-1,"|";
5780 NEXT R%
5790 R%=T%+H%-1
5800 PO%=(R%-1)*40+(L%-1):PRINT@PO%,"+";
5810 FOR I%=1 TO W%-2:PRINT@PO%+I%,"-";:NEXT I%
5820 PRINT@PO%+W%-1,"+";
5830 RETURN

5840 REM CENTERPRINT CR%,TXT$,CL%,CW%
5850 IF CL%<1 THEN CL%=1
5860 IF CW%<1 THEN CW%=40
5870 LN%=LEN(TXT$)
5880 IF LN%>CW% THEN TXT$=LEFT$(TXT$,CW%):LN%=CW%
5890 COL%=CL%+INT((CW%-LN%)/2)
5900 PO%=(CR%-1)*40+(COL%-1)
5910 PRINT@PO%,TXT$;
5920 RETURN

6000 REM TITLE SCREEN (POLISHED)
6020 CLS
6030 BR%=1:BC%=1:BH%=8:BW%=40:GOSUB 5600
6040 CL%=2:CW%=38
6050 CR%=2:TXT$="SNOW DAY":GOSUB 5840
6060 CR%=3:TXT$="DRIVEWAY SHOVELER":GOSUB 5840
6070 CR%=4:TXT$="BY GEORGE M. RIMAKIS":GOSUB 5840
6080 CR%=6:TXT$="PRESS ANY KEY":GOSUB 5840
6090 CR%=7:TXT$=VER$:GOSUB 5840
6100 K$=INKEY$:IF K$="" THEN 6100
6110 RETURN

7000 REM LEVEL SELECT
7020 LL%=LV%:IF LL%<0 OR LL%>5 THEN LL%=1
7040 CLS:MT%=1
7060 REM DRAW MENU AND READ INPUT
7080 REM MENU LOOP
7100 REM DRAW SCREEN
7120 CLS
7130 BR%=1:BC%=1:BH%=8:BW%=40:GOSUB 5600
7140 CL%=2:CW%=38
7150 CR%=2:TXT$="LEVEL SELECT":GOSUB 5840
7160 GOSUB 7700
7180 A1%=82:A2%=122
7200 GOSUB 7840
7220 CR%=7:TXT$="ENTER=START   Q=QUIT":GOSUB 5840
7240 CR%=8:TXT$=VER$:GOSUB 5840
7260 GOTO 7360
7360 K$=INKEY$:IF K$="" THEN 7360
7380 IF K$="Q" OR K$="q" THEN CLEAR:CLS:END
7400 IF K$="W" OR K$="w" OR K$=CHR$(30) THEN MT%=MT%-1:IF MT%<1 THEN MT%=2
7410 IF K$="W" OR K$="w" OR K$=CHR$(30) THEN GOSUB 7840:GOTO 7360
7420 IF K$="S" OR K$="s" OR K$=CHR$(31) THEN MT%=MT%+1:IF MT%>2 THEN MT%=1
7430 IF K$="S" OR K$="s" OR K$=CHR$(31) THEN GOSUB 7840:GOTO 7360
7440 IF K$="A" OR K$="a" OR K$=CHR$(29) THEN GOSUB 7520:GOSUB 7700:GOTO 7360
7460 IF K$="D" OR K$="d" OR K$=CHR$(28) THEN GOSUB 7600:GOSUB 7700:GOTO 7360
7480 IF K$=CHR$(13) THEN LV%=LL%:RETURN
7500 GOTO 7360

7520 REM HANDLE LEFT
7540 IF MT%=1 THEN LL%=LL%-1:IF LL%<0 THEN LL%=5
7560 IF MT%=2 THEN SM%=SM%-1:IF SM%<0 THEN SM%=3
7580 RETURN

7600 REM HANDLE RIGHT
7620 IF MT%=1 THEN LL%=LL%+1:IF LL%>5 THEN LL%=0
7640 IF MT%=2 THEN SM%=SM%+1:IF SM%>3 THEN SM%=0
7660 RETURN

7700 REM DRAW OPTION ROWS
7720 SM$="OFF":IF SM%=1 THEN SM$="LIGHT"
7740 IF SM%=2 THEN SM$="MED"
7760 IF SM%=3 THEN SM$="HEAVY"
7780 PRINT@83," DRIVEWAY LVL: ";LL%;"   ";
7800 PRINT@123," SNOW MODE   : ";SM$;"   ";
7820 RETURN

7840 REM UPDATE MENU ARROW
7860 PRINT@A1%," ":PRINT@A2%," "
7880 IF MT%=1 THEN PRINT@A1%,">" ELSE PRINT@A2%,">"
7900 RETURN

8000 REM SEED RNG (BETTER)
8020 H%=VAL(LEFT$(TIME$,2)):M%=VAL(MID$(TIME$,4,2))
8040 S%=VAL(RIGHT$(TIME$,2))
8060 SD%=H%*3600+M%*60+S%+NZ%:IF SD%<1 THEN SD%=1
8080 FOR I%=1 TO (SD% MOD 31)+5
8100 U!=RND(1):NEXT I%
8120 RETURN

8140 REM RANDOMIZE DRIVEWAY SNOW WITH P0!,P2!
8160 FOR R%=2 TO 7
8180 FOR C%=2 TO 39
8200 IF O%(R%,C%)<>0 THEN S%(R%,C%)=0:GOTO 8300
8220 U!=RND(1)
8240 IF U!<P0! THEN S%(R%,C%)=0:GOTO 8300
8260 IF U!<P0!+P2! THEN S%(R%,C%)=2:GOTO 8300
8280 S%(R%,C%)=1
8300 NEXT C%
8320 NEXT R%
8340 FOR R%=2 TO 7
8360 S%(R%,1)=0
8380 S%(R%,40)=0
8400 NEXT R%
8420 S%(PR%,PC%)=0
8440 RETURN

8460 REM VALIDATE RANDOM SNOW ZERO COUNT
8480 Z%=0
8500 FOR R%=2 TO 7
8520 FOR C%=2 TO 39
8540 IF S%(R%,C%)=0 THEN Z%=Z%+1
8560 NEXT C%
8580 NEXT R%
8600 OK%=1:IF Z%<ZM% THEN OK%=0
8620 RETURN

