10 REM DRIVEWAY SHOVELER (SNOW.DO) - MODEL 100 BASIC
20 REM CONTROLS: W/A/S/D OR ARROWS. R=RESTART, Q=QUIT.
30 DIM S%(9,41),O%(9,41)
34 P0!=0:P2!=0:SM%=0:RD%=0
40 REM DIRECTIONS NOT NEEDED (BFS REMOVED)
75 REM DISABLE SCROLLING
76 PRINT CHR$(27);"V";
78 GOSUB 1400
80 GOSUB 1500
82 GOSUB 8000
85 GOSUB 500
90 GOSUB 600
110 IF WIN% THEN 1200
120 K$=INKEY$:IF K$="" THEN 120
130 IF K$="Q" OR K$="q" THEN GOSUB 1500:GOSUB 8000:GOSUB 500:GOSUB 600:GOTO 110
140 IF K$="R" OR K$="r" THEN GOSUB 8000:GOSUB 500:GOSUB 600:GOTO 110
150 RS%=0:CS%=0
160 IF K$="A" OR K$="a" OR K$=CHR$(29) THEN RS%=0:CS%=-1:GOTO 200
170 IF K$="D" OR K$="d" OR K$=CHR$(28) THEN RS%=0:CS%=1:GOTO 200
180 IF K$="W" OR K$="w" OR K$=CHR$(30) THEN RS%=-1:CS%=0:GOTO 200
190 IF K$="S" OR K$="s" OR K$=CHR$(31) THEN RS%=1:CS%=0:GOTO 200
195 GOTO 110
200 NR%=PR%+RS%:NC%=PC%+CS%
210 IF NR%<1 OR NR%>8 OR NC%<1 OR NC%>40 THEN 110
220 IF NR%<2 OR NR%>7 OR O%(NR%,NC%)<>0 OR S%(NR%,NC%)<>0 THEN 240
230 ROLD%=PR%:COLD%=PC%:PR%=NR%:PC%=NC%
232 RR%=ROLD%:CC%=COLD%:GOSUB 700
234 RR%=PR%:CC%=PC%:GOSUB 700
236 IF PC%=40 THEN WIN%=1:GOTO 1200
238 GOTO 110
240 IF O%(NR%,NC%)<>0 THEN 110
242 IF S%(NR%,NC%)<=0 THEN 110
250 TR%=NR%+RS%:TC%=NC%+CS%
260 IF TR%<1 OR TR%>8 OR TC%<1 OR TC%>40 THEN 110
265 IF O%(TR%,TC%)<>0 THEN 110
270 CAP%=3:IF TR%=1 OR TR%=8 THEN CAP%=5
272 SPACE%=CAP%-S%(TR%,TC%):IF SPACE%<=0 THEN 110
274 MOVE%=S%(NR%,NC%):IF MOVE%>SPACE% THEN MOVE%=SPACE%
285 S%(NR%,NC%)=S%(NR%,NC%)-MOVE%
290 S%(TR%,TC%)=S%(TR%,TC%)+MOVE%
310 RR%=NR%:CC%=NC%:GOSUB 700
315 RR%=TR%:CC%=TC%:GOSUB 700
330 IF WIN% THEN 1200
340 GOTO 110

400 REM SET SNOW PARAMS FROM MODE
410 IF SM%=0 THEN P0!=0:P2!=0:RD%=0:RETURN
420 IF SM%=1 THEN P0!=0.25:P2!=0.05:RD%=1:RETURN
430 IF SM%=2 THEN P0!=0.15:P2!=0.1:RD%=1:RETURN
440 IF SM%=3 THEN P0!=0.05:P2!=0.25:RD%=1:RETURN
450 RETURN

500 REM INIT BOARD
505 WIN%=0:PR%=4:PC%=1
510 FOR R%=1 TO 8
520 FOR C%=1 TO 40
530 IF R%=1 OR R%=8 THEN S%(R%,C%)=0:GOTO 560
540 IF C%=1 OR C%=40 THEN S%(R%,C%)=0 ELSE S%(R%,C%)=1
560 NEXT C%
570 NEXT R%
574 GOSUB 400
575 IF RD%=0 THEN 585
576 GOSUB 5100
577 FOR TR%=1 TO 5
578 GOSUB 5200
579 GOSUB 5400
580 IF OK%=1 THEN GOTO 585
581 NEXT TR%
585 FOR R%=1 TO 8
586 FOR C%=1 TO 40
587 IF O%(R%,C%)<>0 THEN S%(R%,C%)=0
588 NEXT C%
589 NEXT R%
590 RETURN

600 REM DRAW BOARD USING PRINT@
610 CLS
620 FOR R%=1 TO 8
630 FOR C%=1 TO 40
640 RR%=R%:CC%=C%:GOSUB 700
650 NEXT C%
660 NEXT R%
670 RETURN

700 REM DRAW SINGLE CELL AT RR,CC USING PRINT@
710 PO%=(RR%-1)*40+(CC%-1)
712 IF RR%=PR% AND CC%=PC% THEN CH$=CHR$(147):RV%=0:GOTO 770
715 IF O%(RR%,CC%)<>0 THEN CH$="#":RV%=0:GOTO 770
730 IF RR%=1 OR RR%=8 THEN IF S%(RR%,CC%)=0 THEN CH$="w":RV%=0:GOTO 770 ELSE CH$=CHR$(48+S%(RR%,CC%)):RV%=1:GOTO 770
740 IF S%(RR%,CC%)=0 THEN CH$=" ":RV%=0:GOTO 770
745 IF S%(RR%,CC%)=1 THEN CH$=" ":RV%=1:GOTO 770
750 CH$=CHR$(48+S%(RR%,CC%)):RV%=1
770 IF RV%=1 THEN PRINT@PO%,CHR$(27);"p";CH$;CHR$(27);"q";:RETURN
780 PRINT@PO%,CH$;
790 RETURN

1200 REM WIN HANDLER
1210 PRINT
1220 PRINT "WIN! PATH CLEARED. R=RESTART, Q=QUIT"
1230 K$=INKEY$:IF K$="" THEN 1230
1240 IF K$="R" OR K$="r" THEN GOSUB 8000:GOSUB 500:GOSUB 600:GOTO 110
1250 IF K$="Q" OR K$="q" THEN GOSUB 1500:GOSUB 8000:GOSUB 500:GOSUB 600:GOTO 110
1260 GOTO 1230

1400 REM TITLE SCREEN
1410 CLS
1420 PRINT " SNOW DAY"
1430 PRINT " BY GEORGE M. RIMAKIS"
1440 PRINT
1450 PRINT " PRESS ANY KEY..."
1460 K$=INKEY$:IF K$="" THEN 1460
1470 RETURN

1500 REM LEVEL SELECT
1505 LV%=LEVEL%:IF LV%<0 OR LV%>5 THEN LV%=1
1510 CLS:OPT%=1
1520 REM DRAW MENU AND READ INPUT
1525 REM MENU LOOP
1530 REM DRAW SCREEN
1532 CLS
1534 PRINT " LEVEL SELECT"
1535 SM$="OFF":IF SM%=1 THEN SM$="LIGHT"
1536 IF SM%=2 THEN SM$="MED"
1537 IF SM%=3 THEN SM$="HEAVY"
1538 PRINT " DRIVEWAY LVL: ";LV%
1539 PRINT " SNOW MODE : ";SM$
1540 PRINT
1541 PRINT
1545 PRINT " ENTER=START  Q=QUIT"
1550 IF OPT%=1 THEN PRINT@40,">";
1552 IF OPT%=2 THEN PRINT@80,">";
1570 K$=INKEY$:IF K$="" THEN 1570
1580 IF K$="Q" OR K$="q" THEN CLEAR:CLS:END
1590 IF K$="W" OR K$="w" OR K$=CHR$(30) THEN OPT%=OPT%-1:IF OPT%<1 THEN OPT%=2:GOTO 1532 ELSE GOTO 1532
1600 IF K$="S" OR K$="s" OR K$=CHR$(31) THEN OPT%=OPT%+1:IF OPT%>2 THEN OPT%=1:GOTO 1532 ELSE GOTO 1532
1610 IF K$="A" OR K$="a" OR K$=CHR$(29) THEN GOSUB 1700:GOTO 1532
1620 IF K$="D" OR K$="d" OR K$=CHR$(28) THEN GOSUB 1800:GOTO 1532
1630 IF K$=CHR$(13) THEN LEVEL%=LV%:RETURN
1640 GOTO 1570

1700 REM HANDLE LEFT
1710 IF OPT%=1 THEN LV%=LV%-1:IF LV%<0 THEN LV%=5
1720 IF OPT%=2 THEN SM%=SM%-1:IF SM%<0 THEN SM%=3
1730 RETURN

1800 REM HANDLE RIGHT
1810 IF OPT%=1 THEN LV%=LV%+1:IF LV%>5 THEN LV%=0
1820 IF OPT%=2 THEN SM%=SM%+1:IF SM%>3 THEN SM%=0
1830 RETURN

5100 REM SEED RNG USING CLOCK SECONDS
5110 SEC%=VAL(RIGHT$(TIME$,2))
5120 IF SEC%<1 THEN SEC%=1
5130 FOR I%=1 TO SEC%
5140 U!=RND(1)
5150 NEXT I%
5160 RETURN

5200 REM RANDOMIZE DRIVEWAY SNOW WITH P0!,P2!
5210 FOR R%=2 TO 7
5220 FOR C%=2 TO 39
5230 IF O%(R%,C%)<>0 THEN S%(R%,C%)=0:GOTO 5260
5240 U!=RND(1)
5250 IF U!<P0! THEN S%(R%,C%)=0:GOTO 5260
5255 IF U!<P0!+P2! THEN S%(R%,C%)=2:GOTO 5260
5258 S%(R%,C%)=1
5260 NEXT C%
5270 NEXT R%
5280 FOR R%=2 TO 7
5282 S%(R%,1)=0
5283 S%(R%,40)=0
5284 NEXT R%
5286 S%(PR%,PC%)=0
5288 RETURN

5400 REM VALIDATE RANDOM SNOW ZERO COUNT
5410 Z%=0
5420 FOR R%=2 TO 7
5430 FOR C%=2 TO 39
5440 IF S%(R%,C%)=0 THEN Z%=Z%+1
5450 NEXT C%
5460 NEXT R%
5470 OK%=1:IF Z%<10 THEN OK%=0
5480 RETURN

8000 REM LOAD TEMPLATE LV% INTO O%() USING INDEX LISTS
8010 FOR R%=1 TO 8
8020 FOR C%=1 TO 40
8030 O%(R%,C%)=0
8040 NEXT C%
8050 NEXT R%
8055 IF LEVEL%=0 THEN RETURN
8060 IF LEVEL%=1 THEN RESTORE 9000
8070 IF LEVEL%=2 THEN RESTORE 9100
8080 IF LEVEL%=3 THEN RESTORE 9200
8090 IF LEVEL%=4 THEN RESTORE 9300
8100 IF LEVEL%=5 THEN RESTORE 9400
8110 READ IDX%
8120 IF IDX%=0 THEN RETURN
8130 R%=INT((IDX%-1)/40)+1
8140 C%=((IDX%-1) MOD 40)+1
8150 O%(R%,C%)=1
8160 GOTO 8110

9000 DATA 92,153,180,228,0
9100 DATA 60,100,220,260,0
9200 DATA 55,95,135,186,226,266,0
9300 DATA 58,98,108,148,188,218,258,0
9400 DATA 54,74,94,110,114,134,144,184,210,224,262,0
