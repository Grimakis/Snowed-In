10380 REM APPLY LAYER LI% WITH MIRROR/SHIFT
10400 GOSUB 11020
10420 READ ID%
10440 IF ID%=0 THEN RETURN
10460 R%=INT((ID%-1)/40)+1
10480 C%=ID%-(R%-1)*40
10500 IF MI%<>0 THEN C%=41-C%
10520 C%=C%+SH%
10540 IF R%<2 OR R%>7 THEN 10420
10560 IF C%<1 OR C%>40 THEN 10420
10580 TP%=PT%(C%):IF TP%=0 THEN 10420
10600 RT%=TP%
10620 IF R%=RT% OR R%=RT%+1 THEN 10420
10640 IF C%=D1% OR (DN%>1 AND C%=D2%) THEN IF R%=2 OR R%=7 THEN 10420
10660 IF DN%>2 AND C%=D3% THEN IF DP%=0 THEN IF R%=2 OR R%=7 THEN 10420
10680 IF DN%>2 AND C%=D3% THEN IF DP%<>0 THEN IF R%=DP% THEN 10420
10700 O%(R%,C%)=1:GOTO 10420

