10880 IF RND(1)>=SP! THEN 10940
10900 LI%=701+INT(RND(1)*6):MI%=INT(RND(1)*2):GOSUB 9900:GOSUB 10380
10920 IF S2%=0 THEN RETURN
10940 IF S2%=0 THEN RETURN
10960 L2%=701+INT(RND(1)*6)
10980 IF L2%=LI% THEN L2%=701+((L2%-701+1) MOD 6)
11000 LI%=L2%:MI%=INT(RND(1)*2):GOSUB 9900:GOSUB 10380:RETURN

