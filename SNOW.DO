10 REM DRIVEWAY SHOVELER (SNOW.DO) - MODEL 100 BASIC
20 REM CONTROLS: W/A/S/D OR ARROWS. R=RESTART, Q=QUIT.
30 DIM S%(9,41),O%(9,41)
40 REM DIRECTIONS NOT NEEDED (BFS REMOVED)
75 REM DISABLE SCROLLING
76 PRINT CHR$(27);"V";
78 GOSUB 1400
80 GOSUB 1500
82 GOSUB 8000
85 GOSUB 500
90 GOSUB 600
110 IF WIN% THEN 1200
120 K$=INKEY$:IF K$="" THEN 120
130 IF K$="Q" OR K$="q" THEN CLEAR:CLS:END
140 IF K$="R" OR K$="r" THEN GOSUB 8000:GOSUB 500:GOSUB 600:GOTO 110
150 RS%=0:CS%=0
160 IF K$="A" OR K$="a" OR K$=CHR$(29) THEN RS%=0:CS%=-1:GOTO 200
170 IF K$="D" OR K$="d" OR K$=CHR$(28) THEN RS%=0:CS%=1:GOTO 200
180 IF K$="W" OR K$="w" OR K$=CHR$(30) THEN RS%=-1:CS%=0:GOTO 200
190 IF K$="S" OR K$="s" OR K$=CHR$(31) THEN RS%=1:CS%=0:GOTO 200
195 GOTO 110
200 NR%=PR%+RS%:NC%=PC%+CS%
210 IF NR%<1 OR NR%>8 OR NC%<1 OR NC%>40 THEN 110
220 IF NR%<2 OR NR%>7 OR O%(NR%,NC%)<>0 OR S%(NR%,NC%)<>0 THEN 240
230 ROLD%=PR%:COLD%=PC%:PR%=NR%:PC%=NC%
232 RR%=ROLD%:CC%=COLD%:GOSUB 700
234 RR%=PR%:CC%=PC%:GOSUB 700
236 IF PC%=40 THEN WIN%=1:GOTO 1200
238 GOTO 110
240 IF O%(NR%,NC%)<>0 THEN 110
242 IF S%(NR%,NC%)<=0 THEN 110
250 TR%=NR%+RS%:TC%=NC%+CS%
260 IF TR%<1 OR TR%>8 OR TC%<1 OR TC%>40 THEN 110
265 IF O%(TR%,TC%)<>0 THEN 110
270 IF TR%=1 OR TR%=8 THEN SPACE%=5-S%(TR%,TC%):IF SPACE%<=0 THEN 110 ELSE MOVE%=S%(NR%,NC%):IF MOVE%>SPACE% THEN MOVE%=SPACE%
273 GOTO 285
275 IF S%(TR%,TC%)+S%(NR%,NC%)>3 THEN 110
276 MOVE%=S%(NR%,NC%)
285 S%(NR%,NC%)=S%(NR%,NC%)-MOVE%
290 S%(TR%,TC%)=S%(TR%,TC%)+MOVE%
310 RR%=NR%:CC%=NC%:GOSUB 700
315 RR%=TR%:CC%=TC%:GOSUB 700
330 IF WIN% THEN 1200
340 GOTO 110

500 REM INIT BOARD
510 FOR R%=1 TO 8
520 FOR C%=1 TO 40
530 IF R%=1 OR R%=8 THEN S%(R%,C%)=0:GOTO 560
540 IF C%=1 OR C%=40 THEN S%(R%,C%)=0 ELSE S%(R%,C%)=1
560 NEXT C%
570 NEXT R%
585 FOR R%=1 TO 8
586 FOR C%=1 TO 40
587 IF O%(R%,C%)<>0 THEN S%(R%,C%)=0
588 NEXT C%
589 NEXT R%
580 PR%=4:PC%=1:WIN%=0
590 RETURN

600 REM DRAW BOARD USING PRINT@
610 CLS
620 FOR R%=1 TO 8
630 FOR C%=1 TO 40
640 RR%=R%:CC%=C%:GOSUB 700
650 NEXT C%
660 NEXT R%
670 RETURN

700 REM DRAW SINGLE CELL AT RR,CC USING PRINT@
710 PO%=(RR%-1)*40+(CC%-1)
712 IF RR%=PR% AND CC%=PC% THEN CH$=CHR$(147):RV%=0:GOTO 770
715 IF O%(RR%,CC%)<>0 THEN CH$="#":RV%=0:GOTO 770
730 IF RR%=1 OR RR%=8 THEN IF S%(RR%,CC%)=0 THEN CH$="w":RV%=0:GOTO 770 ELSE CH$=CHR$(48+S%(RR%,CC%)):RV%=1:GOTO 770
740 IF S%(RR%,CC%)=0 THEN CH$=" ":RV%=0:GOTO 770
745 IF S%(RR%,CC%)=1 THEN CH$=" ":RV%=1:GOTO 770
750 CH$=CHR$(48+S%(RR%,CC%)):RV%=1
770 IF RV%=1 THEN PRINT@PO%,CHR$(27);"p";CH$;CHR$(27);"q";:RETURN
780 PRINT@PO%,CH$;
790 RETURN

1200 REM WIN HANDLER
1210 PRINT
1220 PRINT "WIN! PATH CLEARED. R=RESTART, Q=QUIT"
1230 K$=INKEY$:IF K$="" THEN 1230
1240 IF K$="R" OR K$="r" THEN GOSUB 8000:GOSUB 500:GOSUB 600:GOTO 110
1250 IF K$="Q" OR K$="q" THEN CLEAR:CLS:END
1260 GOTO 1230

8000 REM LOAD TEMPLATE LEVEL% INTO O%() USING INDEX LISTS
8010 FOR R%=1 TO 8
8020 FOR C%=1 TO 40
8030 O%(R%,C%)=0
8040 NEXT C%
8050 NEXT R%
8060 IF LEVEL%=1 THEN RESTORE 9000
8070 IF LEVEL%=2 THEN RESTORE 9100
8080 IF LEVEL%=3 THEN RESTORE 9200
8090 IF LEVEL%=4 THEN RESTORE 9300
8100 IF LEVEL%=5 THEN RESTORE 9400
8110 READ IDX%
8120 IF IDX%=0 THEN RETURN
8130 R%=INT((IDX%-1)/40)+1
8140 C%=((IDX%-1) MOD 40)+1
8150 O%(R%,C%)=1
8160 GOTO 8110

9000 DATA 60,100,180,220,260,0
9100 DATA 54,67,107,134,174,187,227,254,0
9200 DATA 168,169,170,171,172,173,174,175,176,177,178,179,181,182,183,184,185,186,187,188,189,190,191,192,193,0
9300 DATA 98,99,100,101,102,103,138,143,178,183,218,219,220,221,222,223,0
9400 DATA 50,60,70,90,110,140,170,180,190,210,260,270,0

1400 REM TITLE SCREEN
1410 CLS
1420 PRINT " SNOW DAY"
1430 PRINT " BY GEORGE M. RIMAKIS"
1440 PRINT
1450 PRINT " PRESS ANY KEY..."
1460 K$=INKEY$:IF K$="" THEN 1460
1470 RETURN

1500 REM LEVEL SELECT
1510 CLS
1520 PRINT " LEVEL SELECT"
1530 PRINT
1540 PRINT " 1. LEVEL 1"
1550 PRINT " 2. LEVEL 2"
1560 PRINT " 3. LEVEL 3"
1570 PRINT " 4. LEVEL 4"
1580 PRINT " 5. LEVEL 5"
1590 PRINT
1600 PRINT " SELECT (1-5) OR Q"
1610 K$=INKEY$:IF K$="" THEN 1610
1620 IF K$="Q" OR K$="q" THEN CLEAR:CLS:END
1630 IF K$>="1" AND K$<="5" THEN LEVEL%=VAL(K$):RETURN
1640 GOTO 1610
