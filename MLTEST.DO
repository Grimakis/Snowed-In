1000 REM ML INIT BOARD HARNESS (SNOWED_IN)
1020 ON ERROR GOTO 5000:CLEAR:CLS
1040 DIM S%(9,41),O%(9,41),MC%(80)
1060 LD%=0:MZ%=0:MB%=0:BA!=0:AD!=0:PA!=0
1080 HI%=0:LO%=0:BY%=0:OA%=0:TA%=0
1100 I%=0:R%=0:C%=0:P0%=0:P1%=0:P2%=0:P3%=0:B1%=0:B3%=0:PX%=0
1120 A$="":B$="":C$=""
1140 SP!=0:OP!=0:PB!=0:PB%=0:L1%=0:H1%=0:L2%=0:H2%=0
1160 OF%=70
1180 S%(0,0)=0:O%(0,0)=0:MC%(0)=0
1200 PRINT "PRE LD"
1220 PRINT "LOAD ML? (Y/N)"
1240 A$=INKEY$:IF A$="" THEN 1240
1260 MB%=VARPTR(MC%(0))
1280 BA!=MB%:IF BA!<0 THEN BA!=BA!+65536!
1300 MC%(0)=513
1320 P0%=PEEK(MB%):P1%=PEEK(MB%+1)
1340 P2%=PEEK(MB%+2):P3%=PEEK(MB%+3)
1360 PRINT "PTR0=";P0%;" ";P1%;" PTR2=";P2%;" ";P3%
1380 PRINT "MB=";MB%
1400 IF A$="Y" OR A$="y" THEN GOSUB 8700
1420 PRINT "POST LD"
1440 PRINT "SHOW BYTES? (Y/N)"
1460 A$=INKEY$:IF A$="" THEN 1460
1480 IF A$<>"Y" AND A$<>"y" THEN 1580
1500 FOR I%=0 TO 15:PRINT PEEK(BA!+I%);" ";:NEXT I%:PRINT
1520 PRINT "PATCH:";PEEK(BA!+5);" ";PEEK(BA!+6)
1540 AD!=BA!+79:HI%=INT(AD!/256):LO%=INT(AD!-256!*HI%):PRINT "EXP:";LO%;" ";HI%
1580 PRINT "CALL? (Y/N)"
1600 B$=INKEY$:IF B$="" THEN 1600
1620 IF B$<>"Y" AND B$<>"y" THEN END
1640 GOSUB 9200
1642 P0%=PEEK(PA!):P1%=PEEK(PA!+1):P2%=PEEK(PA!+2):P3%=PEEK(PA!+3)
1644 B1%=PEEK(SP!+44)
1660 CALL MB%,0,PB%
1670 B3%=PEEK(SP!+44)
1682 PRINT "PB:";P0%;" ";P1%;" ";P2%;" ";P3%
1684 PRINT "S22=";S%(2,2);" P44=";B3%
1686 S%(2,2)=7:PX%=PEEK(SP!+44):PRINT "SET7 P44=";PX%
1740 PRINT "CLR? (Y/N)"
1760 C$=INKEY$:IF C$="" THEN 1760
1780 IF C$<>"Y" AND C$<>"y" THEN END
1800 FOR R%=1 TO 8
1820 FOR C%=1 TO 40
1840 O%(R%,C%)=0
1860 NEXT C%
1880 NEXT R%
1900 O%(1,1)=1:O%(4,20)=1:O%(8,40)=1
1920 GOSUB 9200
1940 CALL MB%,1,PB%
1960 PRINT "CLR:";S%(1,1);" ";S%(4,20);" ";S%(8,40)
1980 END

5000 PRINT "ERR ";ERR;" LINE ";ERL
5020 END

8700 REM LOAD/REPATCH INIT ASM
8720 IF MB%=MZ% AND LD%<>0 THEN RETURN
8740 IF LD%=0 THEN RESTORE 17000:FOR I%=0 TO 135:READ BY%:POKE BA!+I%,BY%:NEXT I%
8760 OA%=5:TA%=78:GOSUB 8980:OA%=27:TA%=49:GOSUB 8980
8780 OA%=32:TA%=49:GOSUB 8980:OA%=44:TA%=36:GOSUB 8980
8800 OA%=47:TA%=61:GOSUB 8980:OA%=59:TA%=51:GOSUB 8980
8820 OA%=73:TA%=17:GOSUB 8980:OA%=76:TA%=132:GOSUB 8980
8840 OA%=102:TA%=112:GOSUB 8980:OA%=110:TA%=114:GOSUB 8980
8860 OA%=118:TA%=99:GOSUB 8980:OA%=130:TA%=97:GOSUB 8980
8880 LD%=1:MZ%=MB%:RETURN
8980 REM PATCH JMP AT OA% -> TA%
9000 AD!=BA!+TA%:HI%=INT(AD!/256):LO%=INT(AD!-256!*HI%):POKE BA!+OA%,LO%:POKE BA!+OA%+1,HI%:RETURN

9200 REM PATCH + POKE PARAM BLOCK
9220 MB%=VARPTR(MC%(0))
9240 BA!=MB%:IF BA!<0 THEN BA!=BA!+65536!
9260 GOSUB 8700
9280 SP!=VARPTR(S%(0,0)):IF SP!<0 THEN SP!=SP!+65536!
9300 OP!=VARPTR(O%(0,0)):IF OP!<0 THEN OP!=OP!+65536!
9320 H1%=INT(SP!/256):L1%=INT(SP!-256*H1%)
9340 H2%=INT(OP!/256):L2%=INT(OP!-256*H2%)
9350 PB%=VARPTR(MC%(OF%))
9360 PA!=PB%:IF PA!<0 THEN PA!=PA!+65536!
9370 POKE PA!,L1%:POKE PA!+1,H1%
9380 POKE PA!+2,L2%:POKE PA!+3,H2%
9400 RETURN
9420 RETURN

